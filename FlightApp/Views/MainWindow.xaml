<Window x:Class="FlightApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FlightApp.ViewModels"
        Title="Рефлексия - Управление летательными аппаратами" 
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Загрузка библиотеки" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding LibraryPath, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,5,0" VerticalContentAlignment="Center"
                         ToolTip="Путь к DLL файлу библиотеки"/>
                <Button Grid.Column="1" Content="Загрузить библиотеку" 
                        Command="{Binding LoadLibraryCommand}" 
                        Padding="10,5" FontWeight="Bold"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="Доступные классы" Grid.Row="1" Grid.Column="0" Margin="0,0,5,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="ClassListBox" 
                         ItemsSource="{Binding ClassNames}" 
                         SelectedItem="{Binding SelectedClassName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="100"
                         SelectionMode="Single"
                         Grid.Row="0"/>
                <Button Grid.Row="1" Content="Загрузить методы" 
                        Command="{Binding SelectClassCommand}" 
                        Margin="0,5,0,0" Padding="5"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="Методы класса" Grid.Row="1" Grid.Column="1" Margin="5,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="MethodListBox" 
                         ItemsSource="{Binding Methods}" 
                         SelectedItem="{Binding SelectedMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="100"
                         SelectionMode="Single"
                         Grid.Row="0"/>
                <Button Grid.Row="1" Content="Загрузить параметры" 
                        Command="{Binding SelectMethodCommand}" 
                        Margin="0,5,0,0" Padding="5"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="Параметры метода" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{Binding Parameters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" 
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>

        <Button Grid.Row="3" Grid.ColumnSpan="2" Content="Выполнить метод" 
                Command="{Binding ExecuteMethodCommand}" 
                Height="40" FontSize="14" FontWeight="Bold"
                Background="#4CAF50" Foreground="White"
                Margin="0,0,0,10"/>

        <GroupBox Header="Журнал выполнения" Grid.Row="4" Grid.ColumnSpan="2">
            <ListBox ItemsSource="{Binding LogMessages}" 
                     Background="#F5F5F5"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="11"/>
        </GroupBox>
    </Grid>
</Window>